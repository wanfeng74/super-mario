/*
 * 关卡数据。每个关卡是一组"段" (segment) 对象, 引擎加载时把它们展开成
 * 碰撞体/敌人/金币。坐标系为瓦片 (tile) 坐标, 1 瓦片 = 24px。
 * 地面顶行 y=10 (px 240), 屏幕 960x266 => 40 瓦片宽, 11 瓦片高。
 *
 * 段类型:
 *   {t:'g', x, w, h}        实心地面 (默认贴底, y 可省)
 *   {t:'b', x, y}           砖块 (可顶碎)
 *   {t:'q', x, y, content}  问号块 (顶出金币; content: coin|mushroom|flower|star|1up)
 *   {t:'h', x, y}           硬块 (不可顶碎)
 *   {t:'p', x, h}           管道 (h=2|3 瓦片高)
 *   {t:'c', x, y}           悬空金币
 *   {t:'m', x, y}           敌人出生点 (Goomba, 默认落在地面顶)
 *   {t:'boss', x, y}        库巴 BOSS (4x4 瓦片, 城堡关)
 *   {t:'x', x, y}           斧头 (断桥通关)
 *   {t:'f', x}              旗杆
 *   {t:'k', x}              城堡 (装饰 + 过关终点)
 *   {t:'s', x, y}           玩家出生点
 */

export var WORLD_GROUND_Y = 10 // 地面顶行 (瓦片)
export var WORLD_BLOCKS = 210 // 世界宽 (瓦片)

/* 1-1: 按原版 1-1 重做 (问号块 -> 六块三角 -> 三管道 -> 1UP+坑 -> 砖排 -> 星 -> ?三角 -> 金字塔 -> 四块排 -> 台阶 -> 旗) */
var LEVEL_1 = [
  /* 地面 (两个坑: 三管道后 40-44, 金字塔后 70-74) */
  { t: 'g', x: 0, w: 40 },
  { t: 'g', x: 44, w: 26 }, // 坑 40-44
  { t: 'g', x: 74, w: 136 }, // 坑 70-74

  { t: 's', x: 2, y: 9 },

  /* 开场第一个问号 + 六块三角 (?+砖, 左块蘑菇) */
  { t: 'q', x: 10, y: 7, content: 'coin' },
  { t: 'q', x: 14, y: 8, content: 'mushroom' },
  { t: 'b', x: 15, y: 8 },
  { t: 'b', x: 16, y: 8 },
  { t: 'q', x: 14, y: 7, content: 'coin' },
  { t: 'b', x: 15, y: 7 },
  { t: 'q', x: 14, y: 6, content: 'coin' },

  /* 三根管道一组 (Goomba 在管道间) */
  { t: 'p', x: 20, h: 2 },
  { t: 'p', x: 26, h: 2 },
  { t: 'p', x: 32, h: 2 },

  /* 坑前隐藏 1UP */
  { t: 'q', x: 36, y: 7, content: '1up' },

  /* 坑后: 问号 + 长砖排 (Goomba 从上落下) */
  { t: 'q', x: 46, y: 7, content: 'flower' },
  { t: 'b', x: 48, y: 7 },
  { t: 'b', x: 50, y: 7 },
  { t: 'b', x: 52, y: 7 },
  { t: 'b', x: 54, y: 7 },
  { t: 'b', x: 56, y: 7 },

  /* 星星块 + ? 三角 (顶块 flower) */
  { t: 'b', x: 60, y: 7 },
  { t: 'q', x: 62, y: 7, content: 'star' },
  { t: 'q', x: 64, y: 7, content: 'coin' },
  { t: 'b', x: 65, y: 7 },
  { t: 'q', x: 66, y: 7, content: 'coin' },
  { t: 'q', x: 65, y: 6, content: 'flower' },

  /* 金字塔硬块 (中间缺口) */
