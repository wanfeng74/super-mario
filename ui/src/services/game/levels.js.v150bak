  { t: 'b', x: 98, y: 7 },
  { t: 'b', x: 100, y: 7 },
  { t: 'q', x: 102, y: 7, content: 'coin' },

  /* 最后一根管道 */
  { t: 'p', x: 106, h: 2 },

  /* 结尾阶梯 + 旗杆 */
